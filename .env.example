# Скопируйте в .env и заполните: cp .env.example .env
# .env содержит токен и в git не попадает. Описание переменных — в README.md.

# Токен от @BotFather. Обязательно.
BOT_TOKEN=
# ID канала, куда публикуются объявления, вида -1001234567890. Обязательно.
# Как его узнать — в README.md, «Настройка».
CHANNEL_ID=

# Остальные переменные необязательны: закомментированная строка показывает
# значение по умолчанию. Раскомментируйте, только если нужно другое.

# Принимать объявления только от подписчиков канала.
#BOT_AUTH_ENABLED=true

# info или debug. На debug в лог попадают тексты объявлений и данные
# пользователей — только для отладки.
#LOG_LEVEL=info

# Файл логов и его ротация. В Docker путь уже задан в образе (/app/logs,
# том logs), и значение отсюда перебьёт его — для Docker не указывайте.
#LOG_FILE_PATH=logs/telegram-bot.log
#LOG_MAX_SIZE_MB=20
#LOG_MAX_BACKUPS=5
#LOG_MAX_AGE_DAYS=14
#LOG_COMPRESS=true
